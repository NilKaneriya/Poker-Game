  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>A hand of Texas Hold'em</b>\n\u2022  You get 2 private cards. Up to
    5 shared cards are dealt face up on the table.\n\u2022  Make your best 5-card
    hand from any of those 7 cards.\n\u2022  Betting rounds: Pre-flop, Flop (3 cards),
    Turn (1 card), River (1 card).\n\u2022  On your turn: Fold, Check, Call, Raise
    or All-in. You have 30 seconds.\n\u2022  Win the pot with the best hand at showdown,
    or by being the last player in.\n\n<b>Ties</b>\n\u2022  Same hand type? Higher
    cards win: a pair of Kings beats a pair of Queens.\n\u2022  Still equal? The
    next highest card (the kicker) decides.\n\u2022  Exactly equal hands split the
    pot. Suits never break a tie."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
