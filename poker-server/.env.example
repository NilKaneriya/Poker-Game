PORT=3000
# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*

SMALL_BLIND=10
BIG_BLIND=20
TURN_TIMEOUT_MS=30000
# How long a disconnected player's seat and chips are kept
RECONNECT_GRACE_MS=120000

# Where player data is saved: accounts, profiles, settings, login tokens and stats.
# MongoDB (recommended for a hosted server, e.g. a free MongoDB Atlas cluster):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# MONGODB_DB=poker
# Without MONGODB_URI, JSON files in this folder are used (nothing to install):
DATA_DIR=./data

# Folder with a Unity WebGL build to serve at / (same address for game and server).
# Default: ./public
# WEBGL_DIR=./public
