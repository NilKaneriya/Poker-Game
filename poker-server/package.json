{
  "name": "poker-server",
  "version": "1.0.0",
  "description": "Socket.IO game server for the Unity poker client",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test:client": "node scripts/test-client.js",
    "test:e2e": "node scripts/e2e.js",
    "test": "node --test \"test/**/*.test.js\"",
    "play:bots": "node scripts/play-vs-bots.js",
    "test:mongo": "node scripts/test-mongo.js",
    "test:e2e:mongo": "node scripts/e2e.js --mongo"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongodb": "^6.22.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "socket.io-client": "^4.8.4"
  }
}
